{
  "$schema": "https://raw.githubusercontent.com/nicobatista/tauri-v2-schemas/refs/heads/main/tauri.conf.json",
  "productName": "GoSensei",
  "version": "0.2.0",
  "identifier": "com.gosensei.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GoSensei",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "public.app-category.board-games",
    "macOS": {
      "entitlements": "entitlements/GoSensei.entitlements",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "frameworks": []
    }
  }
}
