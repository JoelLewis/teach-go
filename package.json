{
	"name": "gosensei",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 1420",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"tauri": "tauri",
		"playtest": "tauri dev --features mcp",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "cd tests/e2e && pnpm test",
		"test:e2e:build": "pnpm run tauri build -- --no-default-features && pnpm run test:e2e"
	},
	"dependencies": {
		"@tauri-apps/api": "^2"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5",
		"@tailwindcss/vite": "^4",
		"@tauri-apps/cli": "^2",
		"@testing-library/svelte": "^5",
		"jsdom": "^26",
		"svelte": "^5",
		"svelte-check": "^4",
		"tailwindcss": "^4",
		"tauri-plugin-mcp": "^0.1.0",
		"tauri-plugin-mcp-server": "^0.1.0",
		"typescript": "^5.7",
		"vite": "^6",
		"vitest": "^3"
	},
	"packageManager": "pnpm@11.9.0"
}
